generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERATOR
  VIEWER
}

enum MessageStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  BOUNCED
  FAILED
  COMPLAINED
  REJECTED
  RENDERING_FAILED
  DELIVERY_DELAYED
}

enum EventType {
  QUEUED
  SENDING
  SENT
  DELIVERED
  BOUNCED
  FAILED
  COMPLAINED
  OPENED
  CLICKED
  UNSUBSCRIBED
  REJECTED
  RENDERING_FAILURE
  DELIVERY_DELAY
  SUBSCRIPTION
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  PAUSED
  COMPLETED
  FAILED
}

enum ContactStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
}

enum SuppressionType {
  UNSUBSCRIBED
  HARD_BOUNCE
  COMPLAINT
  MANUAL
}

enum VerificationStatus {
  VERIFIED
  PENDING
  FAILED
  UNVERIFIED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(ADMIN)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  apiKeys      ApiKey[]
}

model Domain {
  id                  String             @id @default(uuid())
  domainName          String             @unique
  spfStatus           VerificationStatus @default(VERIFIED)
  dkimStatus          VerificationStatus @default(VERIFIED)
  dmarcStatus         VerificationStatus @default(VERIFIED)
  sesStatus           VerificationStatus @default(VERIFIED)
  dkimSelector        String             @default("kumo1")
  dkimPublicKey       String             @default("v=DKIM1; k=rsa; p=MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQC...")
  spfRecord           String             @default("v=spf1 include:_spf.kumomta.internal include:amazonses.com ~all")
  dmarcRecord          String             @default("v=DMARC1; p=quarantine; rua=mailto:dmarc-reports@domain.com")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  senders              Sender[]
}

model Sender {
  id             String             @id @default(uuid())
  name           String
  fromEmail      String             @unique
  replyTo        String?
  domainId       String
  domain         Domain             @relation(fields: [domainId], references: [id], onDelete: Cascade)
  status         String             @default("active")
  verification   VerificationStatus @default(VERIFIED)
  dailyLimit     Int                @default(50000)
  hourlyLimit    Int                @default(5000)
  sentCount      Int                @default(0)
  deliveredCount Int                @default(0)
  bouncedCount   Int                @default(0)
  complaintCount Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  messages       Message[]
  campaigns      Campaign[]
}

model Contact {
  id           String             @id @default(uuid())
  email        String             @unique
  firstName    String?
  lastName     String?
  company      String?
  tags         String[]           @default([])
  status       ContactStatus      @default(ACTIVE)
  bounceReason String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  listMembers  ContactListMember[]
  messages     Message[]
}

model ContactList {
  id          String              @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  members     ContactListMember[]
  campaigns   Campaign[]
}

model ContactListMember {
  id        String      @id @default(uuid())
  listId    String
  contactId String
  list      ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact   Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  joinedAt  DateTime    @default(now())

  @@unique([listId, contactId])
}

model ApiKey {
  id         String   @id @default(uuid())
  name       String
  keyPrefix  String
  keyHash    String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?
}

model Suppression {
  id        String          @id @default(uuid())
  email     String          @unique
  type      SuppressionType
  reason    String
  source    String          @default("system")
  createdAt DateTime        @default(now())
}

model Template {
  id          String     @id @default(uuid())
  name        String
  subject     String
  htmlBody    String
  plainText   String?
  variables   String[]   @default([])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  campaigns   Campaign[]
}

model Campaign {
  id              String         @id @default(uuid())
  name            String
  senderId        String
  sender          Sender         @relation(fields: [senderId], references: [id])
  listId          String?
  list            ContactList?   @relation(fields: [listId], references: [id])
  templateId      String?
  template       Template?       @relation(fields: [templateId], references: [id])
  subject         String
  htmlBody        String
  plainText       String?
  status          CampaignStatus @default(DRAFT)
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  totalRecipients Int            @default(0)
  sentCount       Int            @default(0)
  deliveredCount  Int            @default(0)
  bouncedCount    Int            @default(0)
  complaintCount  Int            @default(0)
  openCount       Int            @default(0)
  clickCount      Int            @default(0)
  trackOpens      Boolean        @default(true)
  trackClicks     Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  messages        Message[]
}

model Message {
  id                String         @id @default(uuid())
  messageId         String         @unique
  campaignId        String?
  campaign          Campaign?      @relation(fields: [campaignId], references: [id])
  senderId          String
  sender            Sender         @relation(fields: [senderId], references: [id])
  contactId         String?
  contact           Contact?       @relation(fields: [contactId], references: [id])
  fromEmail         String
  fromName          String?
  toEmail           String
  replyTo           String?
  cc                String[]       @default([])
  bcc               String[]       @default([])
  subject           String
  htmlBody          String?
  plainText         String?
  customHeaders     Json?
  status            MessageStatus  @default(QUEUED)
  provider          String
  providerMessageId String?
  sesMessageId      String?
  smtpResponse      String?
  bounceType        String?
  bounceReason      String?
  queuedAt          DateTime       @default(now())
  sentAt            DateTime?
  deliveredAt       DateTime?
  bouncedAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  events            MessageEvent[]
}

model MessageEvent {
  id          String    @id @default(uuid())
  messageId   String
  message    Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  eventType   EventType
  eventData   Json?
  ipAddress   String?
  userAgent   String?
  geo         String?
  timestamp   DateTime  @default(now())
  createdAt   DateTime  @default(now())
}
