# GEMINI_API_KEY: Optional Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Frontend / Backend URLs
APP_URL="http://localhost:3000"
VITE_API_BASE_URL="https://emailops-api.amiralucia.com"

# Convex primary persistence (backend only)
# Use the deployment URL from the Convex dashboard. Never expose deploy/admin keys to the browser.
CONVEX_URL="https://your-deployment.convex.cloud"

# KumoMTA SMTP Submission Configuration (Backend only)
KUMOMTA_HOST="127.0.0.1"
KUMOMTA_PORT="2525"
KUMOMTA_USERNAME=""
KUMOMTA_PASSWORD=""
KUMO_SMTP_SECURE="false"
KUMOMTA_API_URL="http://127.0.0.1:8000"
KUMO_FROM_EMAIL="security@example.com"
KUMO_FROM_NAME="EmailOps"
KUMO_TLS_REJECT_UNAUTHORIZED="true"

# Amazon SES SMTP Upstream Configuration (Backend only)
SES_SMTP_HOST="email-smtp.eu-west-1.amazonaws.com"
SES_SMTP_PORT="587"
SES_SMTP_USERNAME=""
SES_SMTP_PASSWORD=""
SES_REGION="eu-west-1"
SES_CONFIGURATION_SET="EmailOps-Production-ConfigSet"

# Database Configuration
DATABASE_URL="postgresql://emailops_user:securepass@localhost:5432/emailops_db?schema=public"

# Supabase Auth & Database Configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY=""

# Prometheus Exporter Config
PROMETHEUS_METRICS_ENABLED="true"
PROMETHEUS_SCRAPE_INTERVAL_SEC="15"

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID=""
R2_S3_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="emailops-assets"
R2_PUBLIC_DOMAIN=""
