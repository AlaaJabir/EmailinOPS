# GEMINI_API_KEY: Optional Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Frontend / Backend URLs
# Vite exposes VITE_* variables to the browser at build time.
APP_URL="http://localhost:3000"
VITE_API_BASE_URL="https://emailops-api.amiralucia.com"

# KumoMTA SMTP Submission Configuration (Backend only)
# The production node listens on localhost:2525 and exposes its HTTP listener on localhost:8000.
# Supports either KUMOMTA_HOST or KUMO_SMTP_HOST conventions.
KUMOMTA_HOST="127.0.0.1"
KUMOMTA_PORT="2525"
KUMOMTA_USERNAME=""
KUMOMTA_PASSWORD=""
KUMO_SMTP_SECURE="false"
KUMOMTA_API_URL="http://127.0.0.1:8000"
KUMO_FROM_EMAIL="security@transact.acme-corp.io"
KUMO_FROM_NAME="Acme Security"
KUMO_TLS_REJECT_UNAUTHORIZED="true"

